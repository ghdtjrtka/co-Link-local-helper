#include <windows.h>
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "co-Link"
   VALUE "FileDescription", "co-Link read-only Bluetooth adapter inspector"
   VALUE "FileVersion", "@COLINK_HELPER_VERSION@"
   VALUE "InternalName", "inspect-radio"
   VALUE "OriginalFilename", "inspect-radio.exe"
   VALUE "ProductName", "co-Link Conversion Assistant"
   VALUE "ProductVersion", "@COLINK_HELPER_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
